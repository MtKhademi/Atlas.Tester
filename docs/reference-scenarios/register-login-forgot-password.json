{
  "version": 2,
  "name": "Reference - Register Login Forgot Password",
  "description": "Use a fresh valid Iranian mobile number and a valid password in Test configuration.",
  "steps": [
    { "id": "register", "method": "POST", "path": "/iam/api/auth/register", "displayName": "Register", "requiresAuthentication": false,
      "request": { "method": "POST", "path": "/iam/api/auth/register", "bodyJson": "{\"firstName\":\"Atlas\",\"lastName\":\"Tester\",\"mobileNumber\":\"{{emailOrPhone}}\",\"password\":\"{{password}}\",\"confirmPassword\":\"{{password}}\",\"productKey\":\"oracle\"}" },
      "assertions": [{ "type": "statusRange", "expectedValue": "200-299" }] },
    { "id": "login", "method": "POST", "path": "/iam/api/auth/login", "displayName": "Login", "requiresAuthentication": false,
      "request": { "method": "POST", "path": "/iam/api/auth/login", "bodyJson": "{\"emailOrPhone\":\"{{emailOrPhone}}\",\"password\":\"{{password}}\"}" },
      "captures": [{ "variableName": "accessToken", "jsonPath": "$.accessToken" }], "assertions": [{ "type": "statusCode", "expectedValue": "200" }] },
    { "id": "forgot-password", "method": "POST", "path": "/iam/api/auth/forgot-password", "displayName": "Forgot password", "requiresAuthentication": false,
      "request": { "method": "POST", "path": "/iam/api/auth/forgot-password", "bodyJson": "{\"emailOrPhone\":\"{{emailOrPhone}}\"}" }, "assertions": [{ "type": "statusCode", "expectedValue": "202" }] }
  ]
}
