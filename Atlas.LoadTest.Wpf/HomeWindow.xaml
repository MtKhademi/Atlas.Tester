<Window x:Class="AtlasLoadTestDesktop.HomeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Atlas" Width="1500" Height="900" MinWidth="1200" MinHeight="720" Background="#11151B" WindowStartupLocation="CenterScreen">
<Window.Resources><ControlTemplate x:Key="LeftRailScrollViewerTemplate" TargetType="ScrollViewer"><Grid Background="{TemplateBinding Background}"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="0" Width="6" HorizontalAlignment="Center" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="0" Grid.Column="1" CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}"/><ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" FlowDirection="LeftToRight"/></Grid></ControlTemplate></Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#292A38" BorderBrush="#414353" BorderThickness="0,0,1,0"><StackPanel Margin="12,18"><TextBlock Text="◈" Foreground="#55B5FF" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,28"/><Button Content="⌂&#xA;Home" Click="Home_Click" Background="#393048" Foreground="White" BorderThickness="0" Height="58" Margin="0,0,0,10"/><Button Content="▶&#xA;Tests" Click="Tests_Click" Background="Transparent" Foreground="#B7BBC8" BorderThickness="0" Height="58" Margin="0,0,0,10"/><Button Content="⌘&#xA;Scenarios" Click="Scenarios_Click" Background="Transparent" Foreground="#B7BBC8" BorderThickness="0" Height="58"/><Button Content="◐&#xA;Theme" Click="Theme_Click" Background="Transparent" Foreground="#B7BBC8" BorderThickness="0" Height="58" Margin="0,470,0,0"/></StackPanel></Border><Grid Grid.Column="1"><ScrollViewer x:Name="HomeContent" VerticalScrollBarVisibility="Auto"><StackPanel Margin="30"><TextBlock Text="ATLAS  /  HOME" Foreground="#55B5FF" FontSize="14" FontWeight="Bold"/><TextBlock Text="Performance workspace" Foreground="White" FontSize="32" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="Design scenarios, run real HTTP tests and understand every result" Foreground="#AEB3C0" FontSize="14" Margin="0,0,0,22"/><Border Height="225" CornerRadius="9" Background="#3D968B" Padding="32" Margin="0,0,0,18"><StackPanel VerticalAlignment="Center"><TextBlock Text="ATLAS LOAD TESTING" Foreground="#E7FFFA" FontSize="12"/><TextBlock Text="Fluent performance workspace" Foreground="White" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,5"/><TextBlock Text="Build a reusable API workflow and execute it against your backend" Foreground="#E3FFF9" FontSize="14"/><Button Content="Open the load test" Click="Tests_Click" HorizontalAlignment="Left" Background="#216FA4" Foreground="White" BorderThickness="0" Padding="16,9" Margin="0,18,0,0"/></StackPanel></Border><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="REQUESTS / SEC" Style="{StaticResource Caption}"/><TextBlock Text="—" Style="{StaticResource StatValueBlue}"/><TextBlock Text="Waiting to start" Style="{StaticResource Caption}"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="10,0,0,0"><StackPanel><TextBlock Text="P95 LATENCY" Style="{StaticResource Caption}"/><TextBlock Text="—" Style="{StaticResource StatValueOrange}"/><TextBlock Text="No measurements" Style="{StaticResource Caption}"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="10,0,0,0"><StackPanel><TextBlock Text="SUCCESS RATE" Style="{StaticResource Caption}"/><TextBlock Text="—" Style="{StaticResource StatValueGreen}"/><TextBlock Text="No requests yet" Style="{StaticResource Caption}"/></StackPanel></Border><Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="10,0,0,0"><StackPanel><TextBlock Text="SCENARIOS" Style="{StaticResource Caption}"/><TextBlock Text="4" Style="{StaticResource StatValue}"/><TextBlock Text="Saved locally" Style="{StaticResource Caption}"/></StackPanel></Border></Grid><TextBlock Text="Quick access" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource TileButton}" Click="Tests_Click"><TextBlock Text="▶  Load Test&#xA;Configure and run a real HTTP scenario"/></Button><Button Grid.Column="1" Style="{StaticResource TileButton}" Margin="10,0,0,0" Click="Scenarios_Click"><TextBlock Text="⌘  Scenario Builder&#xA;Compose workflows from OpenAPI"/></Button><Button Grid.Column="2" Style="{StaticResource TileButton}" Margin="10,0,0,0"><TextBlock Text="▤  Reports&#xA;Review your latest test results"/></Button></Grid></StackPanel></ScrollViewer><ContentControl x:Name="PageContent" Visibility="Collapsed" Background="#1B1E27"/></Grid></Grid>
</Window>
