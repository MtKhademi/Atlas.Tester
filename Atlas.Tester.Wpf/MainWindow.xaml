<UserControl x:Class="AtlasTesterDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Background="Transparent" Foreground="#F2F4F7">
<Grid Margin="0" Background="#1B1E27"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Background="#1B1E27" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0"><ui:SymbolIcon Symbol="Globe24" Foreground="#55B5FF" Margin="0,0,8,0"/><TextBlock Text="ATLAS  /  TESTER" Foreground="#55B5FF" FontSize="14" FontWeight="Bold"/></StackPanel><ui:Button Grid.Column="1" Click="CloseWindow_Click" ToolTip="Close" AutomationProperties.Name="Close performance test" Icon="{ui:SymbolIcon Dismiss24}" Width="42" Height="42" Margin="0,0,7,0" Background="#59313B" Foreground="#FFD9DE" BorderBrush="#7D424C"/></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#353746" BorderBrush="#454858" BorderThickness="1" CornerRadius="8" Padding="0"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,0"><StackPanel Margin="0,18,0,18"><TextBlock Text="Test configuration" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="TARGET URL" Foreground="#C8CDD8" FontSize="10" FontWeight="SemiBold"/><TextBox x:Name="TargetUrlBox" Text="http://localhost:5000" Style="{StaticResource CompactTextBox}" Margin="0,5,0,10"/><TextBlock Text="LOGIN EMAIL OR PHONE" Foreground="#C8CDD8" FontSize="10" FontWeight="SemiBold"/><TextBox x:Name="EmailBox" Style="{StaticResource CompactTextBox}" Margin="0,5,0,10"/><TextBlock Text="LOGIN PASSWORD" Foreground="#C8CDD8" FontSize="10" FontWeight="SemiBold"/><PasswordBox x:Name="PasswordBox" Style="{StaticResource CompactPasswordBox}" Margin="0,5,0,10"/><TextBlock Text="SCENARIO" Foreground="#C8CDD8" FontSize="10" FontWeight="SemiBold"/><ComboBox x:Name="ScenarioBox" Style="{StaticResource CompactComboBox}" SelectedIndex="0" SelectionChanged="ScenarioBox_SelectionChanged" Margin="0,5,0,2"><ComboBoxItem Tag="user-portfolio" Content="User portfolio"/><ComboBoxItem Tag="bank-account" Content="Bank account"/><ComboBoxItem Tag="admin-operations" Content="Admin operations"/><ComboBoxItem Tag="market-prices" Content="Market prices"/></ComboBox><TextBlock x:Name="SelectedScenarioLabel" Text="Active: User portfolio" Foreground="#61B7FF" FontSize="11" Margin="3,6,0,0"/><TextBlock x:Name="ScenarioSummary" Text="1 step · 1 expected request" Foreground="#AEB3C0" FontSize="11" Margin="3,3,0,15" TextWrapping="Wrap"/><TextBlock Text="CONCURRENT THREADS" Foreground="#C8CDD8" FontSize="10" FontWeight="SemiBold"/><Slider x:Name="ThreadsSlider" Minimum="1" Maximum="500" Value="1" Margin="0,8,0,2"/><TextBlock x:Name="ThreadsValue" Text="1 thread" Foreground="#AEB3C0" Margin="0,0,0,13"/><TextBlock Text="RAMP-UP (SECONDS)" Foreground="#C8CDD8" FontSize="10" FontWeight="SemiBold"/><Slider x:Name="RampUpSlider" Minimum="0" Maximum="120" Value="10" Margin="0,8,0,2"/><TextBlock x:Name="RampUpValue" Text="10 seconds" Foreground="#AEB3C0" Margin="0,0,0,13"/><TextBlock Text="ITERATIONS PER THREAD" Foreground="#C8CDD8" FontSize="10" FontWeight="SemiBold"/><TextBox x:Name="IterationsBox" Text="1" Style="{StaticResource CompactTextBox}" Margin="0,5,0,14"/><CheckBox x:Name="AcknowledgeBox" Content="I understand this can stress the target" Foreground="#AEB3C0" Margin="0,0,0,18"/><StackPanel Orientation="Horizontal"><ui:Button x:Name="StartButton" Click="StartButton_Click" ToolTip="Start test" AutomationProperties.Name="Start test" Icon="{ui:SymbolIcon Play24}" Margin="0,0,8,0"/><ui:Button x:Name="StopButton" Click="StopButton_Click" ToolTip="Stop test" AutomationProperties.Name="Stop test" Icon="{ui:SymbolIcon Stop24}"/></StackPanel></StackPanel></ScrollViewer></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="125"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="REQUESTS / SEC" Style="{StaticResource Caption}"/><TextBlock x:Name="RequestsValue" Text="—" Style="{StaticResource StatValueBlue}"/><TextBlock x:Name="RequestsHint" Text="Waiting to start" Style="{StaticResource Caption}"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="P95 LATENCY" Style="{StaticResource Caption}"/><TextBlock x:Name="LatencyValue" Text="—" Style="{StaticResource StatValueOrange}"/><TextBlock x:Name="LatencyHint" Text="No measurements" Style="{StaticResource Caption}"/></StackPanel></Border><Border Grid.Column="4" Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="SUCCESS RATE" Style="{StaticResource Caption}"/><TextBlock x:Name="SuccessValue" Text="—" Style="{StaticResource StatValueGreen}"/><TextBlock x:Name="SuccessHint" Text="No requests yet" Style="{StaticResource Caption}"/></StackPanel></Border></Grid><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><Border Background="#353746" BorderBrush="#454858" BorderThickness="1" CornerRadius="8" Padding="20"><StackPanel><TextBlock Text="Live report" FontSize="17" FontWeight="SemiBold"/><Border Background="#2B2C3A" CornerRadius="6" Height="90" Margin="0,14,0,14"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ChartStatus" Text="Ready to run · results will appear here" Foreground="#AEB3C0" HorizontalAlignment="Center"/><ProgressBar x:Name="MockProgress" Height="7" Margin="30,12,30,0" Value="0"/></StackPanel></Border><TextBlock x:Name="ReportStatus" Text="No test has run yet. Reports will be generated after completion." Foreground="#AEB3C0"/><TextBlock x:Name="OutputStatus" Text="Output: tests/Tester/reports/latest" Foreground="#8F96A8" Margin="0,8,0,0"/><Grid x:Name="ReportTable" Visibility="Collapsed" Margin="0,16,0,0"/></StackPanel></Border></ScrollViewer></Grid></Grid></Grid>
</UserControl>
