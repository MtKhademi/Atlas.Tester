<UserControl x:Class="AtlasTesterDesktop.ScenarioBuilderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Background="#2B2C3A" Foreground="#F2F4F7">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Globe24" Foreground="#55B5FF" Margin="0,0,7,0"/><TextBlock Text="ATLAS  /  SCENARIO BUILDER" Foreground="#55B5FF" FontSize="14" FontWeight="Bold"/></StackPanel><TextBlock Text="Build a real API workflow" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="Drag operations from the live OpenAPI catalog into a reusable test scenario" Foreground="#AEB3C0" FontSize="13" Margin="0,4,0,0"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#353746" BorderBrush="#454858" BorderThickness="1" CornerRadius="8"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="16,16,16,0"><TextBlock Text="API CATALOG" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Drag an operation into the canvas" Foreground="#8F96A8" FontSize="11" Margin="0,4,0,12"/></StackPanel><ListBox x:Name="ApiList" PreviewMouseMove="ApiList_PreviewMouseMove" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,16,0" Background="Transparent" BorderThickness="0"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Foreground="#D8DCE5" TextWrapping="Wrap" Margin="0,3"/></DataTemplate></ListBox.ItemTemplate><ListBox.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander IsExpanded="False" Background="#40546B" Foreground="#EAF3FF" Margin="0,7,0,5" Padding="8,5"><Expander.Header><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></Expander.Header><ItemsPresenter Margin="0,4,0,0"/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ListBox.GroupStyle></ListBox></DockPanel></Border>
      <Border Grid.Column="2" Background="#353746" BorderBrush="#454858" BorderThickness="1" CornerRadius="8" Padding="20"><DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="SCENARIO NAME" Foreground="#AEB3C0" FontSize="10" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="NameBox" Style="{StaticResource CompactTextBox}"/><TextBlock Grid.Column="2" x:Name="ScenarioStepCount" Text="0 steps · drag to add" Foreground="#8F96A8" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SAVED SCENARIO" Foreground="#AEB3C0" FontSize="10" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="SavedScenariosBox" DisplayMemberPath="Name" SelectionChanged="SavedScenariosBox_SelectionChanged" Style="{StaticResource CompactComboBox}"/><ui:Button Grid.Column="2" Click="RefreshSavedScenarios_Click" ToolTip="Refresh saved scenarios" Icon="{ui:SymbolIcon ArrowClockwise24}" Margin="8,0,0,0"/></Grid>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="DESCRIPTION" Foreground="#AEB3C0" FontSize="10" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="DescriptionBox" Style="{StaticResource CompactTextBox}"/></Grid>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12"><ui:Button Click="Clear_Click" ToolTip="Clear workflow" Icon="{ui:SymbolIcon Broom24}" Margin="0,0,8,0"/><ui:Button Click="ToggleImport_Click" ToolTip="Paste scenario JSON" Icon="{ui:SymbolIcon ClipboardPaste24}" Margin="0,0,8,0"/><ui:Button Click="OpenScenarioFolder_Click" ToolTip="Open saved scenarios folder" Icon="{ui:SymbolIcon Folder24}" Margin="0,0,8,0"/><ui:Button Click="Save_Click" ToolTip="Save scenario" Icon="{ui:SymbolIcon Save24}"/></StackPanel>
        <Border x:Name="ImportPanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="#2B3340" BorderBrush="#5D7286" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="IMPORT SCENARIO JSON" FontWeight="SemiBold"/><TextBlock Text="Paste a scenario JSON. Its name, description, nodes and node inputs will be loaded for editing." Foreground="#AEB3C0" FontSize="11" Margin="0,4,0,8"/><TextBox x:Name="ImportJsonBox" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><ui:Button Click="ImportJson_Click" Content="Load JSON" Icon="{ui:SymbolIcon ArrowDownload24}"/></StackPanel></StackPanel></Border>
        <Border DockPanel.Dock="Bottom" Background="#2B3340" BorderBrush="#5D7286" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0"><StackPanel><TextBlock Text="NODE DETAILS" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="NodeEditorEmptyState" Text="Select a node on the canvas to view or edit its request data." Foreground="#8F96A8" FontSize="11" Margin="0,4,0,0"/><Grid x:Name="NodeEditor" Visibility="Collapsed" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="NodeDisplayNameBox" Grid.Column="0" Margin="0,0,6,6" Style="{StaticResource CompactTextBox}" ToolTip="Node display name"/><TextBox x:Name="NodeMethodBox" Grid.Column="1" Margin="6,0,0,6" Style="{StaticResource CompactTextBox}" ToolTip="HTTP method"/><TextBox x:Name="NodePathBox" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,6" Style="{StaticResource CompactTextBox}" ToolTip="Request path"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="NodeBodyBox" Grid.Column="0" Height="92" Margin="0,0,6,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" ToolTip="Request body JSON"/><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBox x:Name="NodeHeadersBox" Height="27" Margin="0,0,0,5" Style="{StaticResource CompactTextBox}" ToolTip="Headers JSON object"/><TextBox x:Name="NodeQueryBox" Height="27" Margin="0,0,0,5" Style="{StaticResource CompactTextBox}" ToolTip="Query JSON object"/><TextBox x:Name="NodePathParametersBox" Height="27" Style="{StaticResource CompactTextBox}" ToolTip="Path parameters JSON object"/></StackPanel></Grid><ui:Button Grid.Row="3" Grid.ColumnSpan="2" Click="ApplyNodeEdits_Click" Content="Apply node changes" HorizontalAlignment="Right" Margin="0,8,0,0" Icon="{ui:SymbolIcon Checkmark24}"/></Grid></StackPanel></Border>
        <Border Background="#2B3340" BorderBrush="#5D7286" BorderThickness="1" CornerRadius="6" AllowDrop="True" Drop="Canvas_Drop"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Canvas x:Name="WorkflowCanvas" Background="#2B3340" AllowDrop="True" MinHeight="450"/><TextBlock x:Name="WorkflowEmptyState" Text="Drag an API operation here to start building your workflow" Foreground="#8F96A8" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False"/></Grid></ScrollViewer></Border>
      </DockPanel></Border>
    </Grid>
  </Grid>
</UserControl>
