<Application x:Class="Atlas.Tester.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="HomeWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CompactTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
            <Style x:Key="CompactPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}"><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
            <Style x:Key="CompactComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="6,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
            <Style x:Key="StatCard" TargetType="Border"><Setter Property="Background" Value="#353746"/><Setter Property="BorderBrush" Value="#454858"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="14"/></Style>
            <Style x:Key="TileButton" TargetType="Button"><Setter Property="Background" Value="#353746"/><Setter Property="Foreground" Value="#F2F4F7"/><Setter Property="BorderBrush" Value="#454858"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Height" Value="100"/></Style>
            <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#AEB3C0"/><Setter Property="FontSize" Value="11"/></Style>
            <Style x:Key="StatValue" TargetType="TextBlock"><Setter Property="Foreground" Value="#F2F4F7"/><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,3"/></Style>
            <Style x:Key="StatValueBlue" TargetType="TextBlock" BasedOn="{StaticResource StatValue}"><Setter Property="Foreground" Value="#61B7FF"/></Style>
            <Style x:Key="StatValueOrange" TargetType="TextBlock" BasedOn="{StaticResource StatValue}"><Setter Property="Foreground" Value="#F2B466"/></Style>
            <Style x:Key="StatValueGreen" TargetType="TextBlock" BasedOn="{StaticResource StatValue}"><Setter Property="Foreground" Value="#53D2B4"/></Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
